# macOS
# .DS_Store is also listed under Miscellaneous below by the Flutter template;
# these are the rest of the artefacts Finder and macOS volumes leave behind.
.DS_Store
.AppleDouble
.AppleDB
.AppleDesktop
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
# AppleDouble resource forks, created on non-native volumes, USB drives and zips
._*

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Supabase credentials (see env.example.json)
env.json

# Design source archives. The wireframes are tracked unzipped in
# _docs/design-guidelines/; the zip is a 23MB duplicate of the same thing.
_docs/briefs/*.zip
