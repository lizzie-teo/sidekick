# macOS
# .DS_Store is also listed under Miscellaneous below by the Flutter template;
# these are the rest of the artefacts Finder and macOS volumes leave behind.
.DS_Store
.AppleDouble
.AppleDB
.AppleDesktop
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
# AppleDouble resource forks, created on non-native volumes, USB drives and zips
._*

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Supabase credentials (see env.example.json)
env.json

# Design source archives. The wireframes are tracked unzipped in
# _docs/design-guidelines/; the zip is a 23MB duplicate of the same thing.
_docs/briefs/*.zip

# Claude Code worktrees. These are whole extra checkouts of this repo
# (~176MB), not source. The skills in .claude/skills/ are tracked.
.claude/worktrees/
.claude/scheduled_tasks.lock

# Third-party animation books. Reference material, not ours to publish,
# and this repo is public. The notes drawn from them are tracked as .md.
_docs/skills/*.pdf

# Third-party clinical handouts and the source art they came with. Same rule
# as the animation books above, and it matters more here: the Centre for
# Clinical Interventions modules are Crown copyright (State of Western
# Australia) and their terms allow downloading for personal use only -- no
# publishing, no reproduction in any material form. A public repo is both.
#
# So the whole folder is ignored rather than the PDFs alone. A transcription
# into Markdown is still a reproduction, and two of those were committed here
# before anybody checked. What is tracked is the brief: our own sentences,
# with a page reference where a thought came from theirs.
_docs/references/
